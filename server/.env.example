# Copie este arquivo para server/.env e ajuste os valores.
# O arquivo .env real nunca vai para o GitHub (está no .gitignore).

# Porta do back-end local. O front-end (Vite) encaminha /api para cá.
PORT=3001

# Versão do prompt usada pelos usuários finais: v1 ou v2.
# O usuário final não escolhe a versão; só este arquivo define.
PROMPT_VERSION=v2

# Ambiente de testes (red teaming). Em produção, deixe false.
LAB_MODE=false

# Token exigido pelas rotas /api/lab quando LAB_MODE=true.
# Use pelo menos 16 caracteres aleatórios. Nunca reutilize uma senha real.
LAB_TOKEN=

# Etapa 3: as variáveis do provedor de IA entram aqui, sem valores reais neste arquivo.
